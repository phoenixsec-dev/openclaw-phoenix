{
  plugins: {
    allow: ["phoenix-secrets"],
    entries: {
      "phoenix-secrets": {
        enabled: true,
        config: {
          server: "${PHOENIX_SERVER}",
          sealMode: true,
          agents: {
            main: {
              tokenFile: "${PHOENIX_TOKEN_FILE_MAIN}",
              sealKeyFile: "${PHOENIX_SEAL_KEY_MAIN}",
              defaultNamespace: "${PHOENIX_DEFAULT_NAMESPACE_MAIN}"
            },
            kit: {
              tokenFile: "${PHOENIX_TOKEN_FILE_KIT}",
              sealKeyFile: "${PHOENIX_SEAL_KEY_KIT}",
              defaultNamespace: "${PHOENIX_DEFAULT_NAMESPACE_KIT}"
            },
            phoenix: {
              tokenFile: "${PHOENIX_TOKEN_FILE_PHOENIX}",
              sealKeyFile: "${PHOENIX_SEAL_KEY_PHOENIX}",
              defaultNamespace: "${PHOENIX_DEFAULT_NAMESPACE_PHOENIX}"
            },
            echo: {
              tokenFile: "${PHOENIX_TOKEN_FILE_ECHO}",
              sealKeyFile: "${PHOENIX_SEAL_KEY_ECHO}",
              defaultNamespace: "${PHOENIX_DEFAULT_NAMESPACE_ECHO}"
            },
            relay: {
              tokenFile: "${PHOENIX_TOKEN_FILE_RELAY}",
              sealKeyFile: "${PHOENIX_SEAL_KEY_RELAY}",
              defaultNamespace: "${PHOENIX_DEFAULT_NAMESPACE_RELAY}"
            }
          }
        }
      }
    }
  }
}
