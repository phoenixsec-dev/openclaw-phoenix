{
  plugins: {
    allow: ["phoenix-secrets"],
    entries: {
      "phoenix-secrets": {
        enabled: true,
        config: {
          server: "${PHOENIX_SERVER}",
          sealMode: true,
          agents: {
            main: {
              tokenFile: "${PHOENIX_TOKEN_FILE_MAIN}",
              sealKeyFile: "${PHOENIX_SEAL_KEY_MAIN}",
              defaultNamespace: "${PHOENIX_DEFAULT_NAMESPACE_MAIN}"
            },
            "example-agent": {
              tokenFile: "${PHOENIX_TOKEN_FILE_EXAMPLE_AGENT}",
              sealKeyFile: "${PHOENIX_SEAL_KEY_EXAMPLE_AGENT}",
              defaultNamespace: "${PHOENIX_DEFAULT_NAMESPACE_EXAMPLE_AGENT}"
            },
            "my-agent": {
              tokenFile: "${PHOENIX_TOKEN_FILE_MY_AGENT}",
              sealKeyFile: "${PHOENIX_SEAL_KEY_MY_AGENT}",
              defaultNamespace: "${PHOENIX_DEFAULT_NAMESPACE_MY_AGENT}"
            }
          }
        }
      }
    }
  }
}
