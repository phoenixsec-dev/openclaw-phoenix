# Token and seal-key files must have no group/other bits (chmod 600 recommended).

# phoenix:9090 is a non-loopback address, so this example uses https:// and
# expects the Phoenix CA certificate to be configured (caCert in the plugin
# config, or PHOENIX_CA_CERT). For a single-machine setup, plaintext loopback
# is the supported default instead: PHOENIX_SERVER=http://127.0.0.1:9090.
# Non-loopback http:// would send the bearer token and secret values in
# cleartext and makes the plugin log a security warning.
PHOENIX_SERVER=https://phoenix:9090

PHOENIX_TOKEN_FILE_MAIN=/path/to/tokens/main
PHOENIX_TOKEN_FILE_KIT=/path/to/tokens/kit
PHOENIX_TOKEN_FILE_PHOENIX=/path/to/tokens/phoenix
PHOENIX_TOKEN_FILE_ECHO=/path/to/tokens/echo
PHOENIX_TOKEN_FILE_RELAY=/path/to/tokens/relay

PHOENIX_SEAL_KEY_MAIN=/path/to/keys/main.seal.key
PHOENIX_SEAL_KEY_KIT=/path/to/keys/kit.seal.key
PHOENIX_SEAL_KEY_PHOENIX=/path/to/keys/phoenix.seal.key
PHOENIX_SEAL_KEY_ECHO=/path/to/keys/echo.seal.key
PHOENIX_SEAL_KEY_RELAY=/path/to/keys/relay.seal.key

PHOENIX_DEFAULT_NAMESPACE_MAIN=openclaw-main
PHOENIX_DEFAULT_NAMESPACE_KIT=openclaw-kit
PHOENIX_DEFAULT_NAMESPACE_PHOENIX=openclaw-phoenix
PHOENIX_DEFAULT_NAMESPACE_ECHO=openclaw-echo
PHOENIX_DEFAULT_NAMESPACE_RELAY=openclaw-relay
