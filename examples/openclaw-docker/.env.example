PHOENIX_SERVER=http://phoenix:9090
OPENCLAW_GATEWAY_PORT=8080

PHOENIX_TOKEN_FILE_MAIN=/run/phoenix/tokens/main
PHOENIX_TOKEN_FILE_KIT=/run/phoenix/tokens/kit
PHOENIX_TOKEN_FILE_PHOENIX=/run/phoenix/tokens/phoenix
PHOENIX_TOKEN_FILE_ECHO=/run/phoenix/tokens/echo
PHOENIX_TOKEN_FILE_RELAY=/run/phoenix/tokens/relay

PHOENIX_TOKEN_FILE_MAIN_HOST=./tokens/main
PHOENIX_TOKEN_FILE_KIT_HOST=./tokens/kit
PHOENIX_TOKEN_FILE_PHOENIX_HOST=./tokens/phoenix
PHOENIX_TOKEN_FILE_ECHO_HOST=./tokens/echo
PHOENIX_TOKEN_FILE_RELAY_HOST=./tokens/relay

PHOENIX_SEAL_KEY_MAIN=/run/phoenix/keys/main.seal.key
PHOENIX_SEAL_KEY_KIT=/run/phoenix/keys/kit.seal.key
PHOENIX_SEAL_KEY_PHOENIX=/run/phoenix/keys/phoenix.seal.key
PHOENIX_SEAL_KEY_ECHO=/run/phoenix/keys/echo.seal.key
PHOENIX_SEAL_KEY_RELAY=/run/phoenix/keys/relay.seal.key

PHOENIX_SEAL_KEY_MAIN_HOST=./keys/main.seal.key
PHOENIX_SEAL_KEY_KIT_HOST=./keys/kit.seal.key
PHOENIX_SEAL_KEY_PHOENIX_HOST=./keys/phoenix.seal.key
PHOENIX_SEAL_KEY_ECHO_HOST=./keys/echo.seal.key
PHOENIX_SEAL_KEY_RELAY_HOST=./keys/relay.seal.key

PHOENIX_DEFAULT_NAMESPACE_MAIN=openclaw-main
PHOENIX_DEFAULT_NAMESPACE_KIT=openclaw-kit
PHOENIX_DEFAULT_NAMESPACE_PHOENIX=openclaw-phoenix
PHOENIX_DEFAULT_NAMESPACE_ECHO=openclaw-echo
PHOENIX_DEFAULT_NAMESPACE_RELAY=openclaw-relay
