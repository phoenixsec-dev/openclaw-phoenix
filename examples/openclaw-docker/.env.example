# Host files referenced by *_HOST variables must exist with no group/other bits.
# Use chmod 600 for token and seal-key files before docker compose up; :ro mounts are not enough.

# PHOENIX_SERVER below is plain http:// across the Compose bridge network — a
# non-loopback wire, so the bearer token and resolved secret values travel in
# cleartext, readable by anything on that bridge. That is acceptable only for
# a single-host lab stack where every container on the bridge is trusted; the
# plugin logs a security warning for it either way. When gateway-to-Phoenix
# traffic crosses a real wire, use docker-compose.mtls.yml or switch this to
# https://phoenix:9090 with PHOENIX_CA_CERT set to the Phoenix CA certificate.
PHOENIX_SERVER=http://phoenix:9090
OPENCLAW_GATEWAY_PORT=8080

PHOENIX_TOKEN_FILE_MAIN=/run/phoenix/tokens/main
PHOENIX_TOKEN_FILE_EXAMPLE_AGENT=/run/phoenix/tokens/example-agent
PHOENIX_TOKEN_FILE_MY_AGENT=/run/phoenix/tokens/my-agent

PHOENIX_TOKEN_FILE_MAIN_HOST=./tokens/main
PHOENIX_TOKEN_FILE_EXAMPLE_AGENT_HOST=./tokens/example-agent
PHOENIX_TOKEN_FILE_MY_AGENT_HOST=./tokens/my-agent

PHOENIX_SEAL_KEY_MAIN=/run/phoenix/keys/main.seal.key
PHOENIX_SEAL_KEY_EXAMPLE_AGENT=/run/phoenix/keys/example-agent.seal.key
PHOENIX_SEAL_KEY_MY_AGENT=/run/phoenix/keys/my-agent.seal.key

PHOENIX_SEAL_KEY_MAIN_HOST=./keys/main.seal.key
PHOENIX_SEAL_KEY_EXAMPLE_AGENT_HOST=./keys/example-agent.seal.key
PHOENIX_SEAL_KEY_MY_AGENT_HOST=./keys/my-agent.seal.key

PHOENIX_DEFAULT_NAMESPACE_MAIN=openclaw-main
PHOENIX_DEFAULT_NAMESPACE_EXAMPLE_AGENT=openclaw-example-agent
PHOENIX_DEFAULT_NAMESPACE_MY_AGENT=openclaw-my-agent
